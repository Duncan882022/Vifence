# URL backend — bake vào GitHub Pages build (npm run build:pages).
VITE_MOBILE_AI_BACKEND_URL=https://217.217.253.247.nip.io
VITE_VMS_BACKEND_URL=https://217.217.253.247.nip.io

# HC-01 — HLS qua backend VMS (MediaMTX pull RTSP nội bộ → worker → HLS)
