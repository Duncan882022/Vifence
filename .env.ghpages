# Trang phát sóng — tài khoản kiosk (operator) để gửi GPS qua WebSocket JWT.
# Chỉ dùng trên trang /phat-song, không phải tài khoản CMS.
VITE_HELMET_PUBLISHER_USER=publisher
VITE_HELMET_PUBLISHER_PASS=pub5318

VITE_DEMO_AUTH=true
VITE_MOBILE_AI_BACKEND_URL=https://217.217.253.247.nip.io
VITE_VMS_BACKEND_URL=https://217.217.253.247.nip.io
# Demo CMS vẫn cần JWT cho /patrol/day/* — khớp PATROL_AUTH_USERS trên VPS.
VITE_PATROL_DEMO_USERNAME=admin
VITE_PATROL_DEMO_PASSWORD=admin123

# HC-01 — bodycam: MediaMTX LL-HLS gốc (WHEP ưu tiên trong app)
VITE_HC01_STREAM_URL=https://217.217.253.247.nip.io/mediamtx/hls/hc-01/index.m3u8

# MediaMTX — pipeline thống nhất helmet (RTMP publish / WHEP play / HLS fallback)
# Proxy qua nginx trên cùng VPS — bắt buộc HTTPS vì CMS chạy trên GitHub Pages.
VITE_MEDIAMTX_WEBRTC_URL=https://217.217.253.247.nip.io/mediamtx/webrtc
VITE_MEDIAMTX_HLS_URL=https://217.217.253.247.nip.io/mediamtx/hls
# Playback Server (cổng 9996) — đọc lại băng đã ghi. Biến này phải có **lúc
# build**, thiếu là tab Xem lại ra danh sách rỗng.
VITE_MEDIAMTX_PLAYBACK_URL=https://217.217.253.247.nip.io/mediamtx/playback

# HC-02 — video qua app RTMP (Larix/OBS), giống flycam — không cần tab /phat-song cho hình
VITE_HELMET_HC02_INGEST=rtmp
VITE_HC02_RTMP_URL=rtmp://217.217.253.247:1935/hc-02
VITE_HC02_STREAM_URL=https://217.217.253.247.nip.io/mediamtx/hls/hc-02/index.m3u8

# DR-03 — flycam tuần tra (backend pull RTMP → HLS relay)
VITE_DR03_STREAM_URL=https://217.217.253.247.nip.io/mediamtx/hls/dr03/index.m3u8
# Nguồn gốc (browser không phát trực tiếp — chỉ tham chiếu):
# VITE_DR03_RTMP_URL=rtmp://157.66.190.182/flycam

# JSMpeg fallback (local dev / vifence.io worker):
# VITE_HC01_WS_URL=wss://...
