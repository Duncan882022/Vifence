# Copy thành .env.local (dev) hoặc dùng .env.ghpages (GitHub Pages build).
# Local dev mặc định: npm run setup:local hoặc npm run start:local

# ── Auth ──────────────────────────────────────────────────────────────────
# false = bắt buộc đăng nhập patrol/Vifence · true = demo CMS (GitHub Pages)
VITE_DEMO_AUTH=false
# Khi VITE_DEMO_AUTH=true — auto signin JWT (khớp PATROL_AUTH_USERS backend):
# VITE_PATROL_DEMO_USERNAME=admin
# VITE_PATROL_DEMO_PASSWORD=admin123

# ── Backend AI ────────────────────────────────────────────────────────────
# Backend local Mac (npm run start:local):
VITE_MOBILE_AI_BACKEND_URL=http://127.0.0.1:8000
VITE_VMS_BACKEND_URL=http://127.0.0.1:8000

# Patrol API (mặc định dùng chung VMS/Mobile AI URL ở trên):
# VITE_PATROL_BACKEND_URL=http://127.0.0.1:8000

# Backend Contabo VPS (GitHub Pages — xem .env.ghpages):
# VITE_MOBILE_AI_BACKEND_URL=https://217.217.253.247.nip.io
# VITE_VMS_BACKEND_URL=https://217.217.253.247.nip.io

# ── MediaMTX — pipeline thống nhất cho mọi helmet ─────────────────────────
# Đặt host là bật kiến trúc mới: điện thoại publish WHIP, CMS xem WHEP/HLS,
# backend pull RTSP nội bộ để chạy AI. Bỏ trống → HC-02 chạy luồng cũ
# (getUserMedia → POST /analyze/frame) để bản demo hiện tại không gãy.
# VITE_MEDIAMTX_HOST=157.66.100.182
# VITE_MEDIAMTX_WEBRTC_PORT=8889
# VITE_MEDIAMTX_HLS_PORT=8888

# Hoặc chỉ định thẳng URL (khi có reverse proxy TLS):
# VITE_MEDIAMTX_WEBRTC_URL=https://media.vifence.io
# VITE_MEDIAMTX_HLS_URL=https://media.vifence.io

# Mũ publish từ trình duyệt WHIP (legacy). HC-02 mặc định dùng RTMP native.
# VITE_HELMET_WHIP_IDS=HC-02

# HC-02 ingest: rtmp (Larix/OBS — khuyến nghị) | whip | legacy-mobile
# VITE_HELMET_HC02_INGEST=rtmp
# VITE_HC02_RTMP_URL=rtmp://217.217.253.247:1935/hc-02
# VITE_HC02_STREAM_URL=https://217.217.253.247.nip.io/mediamtx/hls/hc-02/index.m3u8

# Basic auth cho WHIP publish (MediaMTX bật auth):
# VITE_WHIP_USER=publisher
# VITE_WHIP_PASS=secret

# Trang phát sóng kiosk (/phat-song) — JWT cho kênh GPS telemetry:
# VITE_HELMET_PUBLISHER_USER=publisher
# VITE_HELMET_PUBLISHER_PASS=pub5318

# ── HC-01 ─────────────────────────────────────────────────────────────────
# RTSP gốc (backend/MediaMTX pull — browser không phát RTSP trực tiếp)
# VITE_HC01_RTSP_URL=rtsp://157.66.100.182:8554/866926048126915
# HLS — ưu tiên MediaMTX LL-HLS (WHEP trong app ~300ms):
# VITE_HC01_STREAM_URL=https://217.217.253.247.nip.io/mediamtx/hls/hc-01/index.m3u8
# JSMpeg fallback (local dev — Vision API bị CORS trên localhost):
# VITE_HC01_WS_URL=wss://your-worker-host/camera-id

# ── DR-03 (Drone 03 — flycam Module 05) ───────────────────────────────────
# Flycam đẩy RTMP vào server drone; backend Contabo pull về relay HLS cho CMS.
#
# Nguồn RTMP (drone DJI push từ app — Contabo nhận, không pull từ server Indonesia):
#   rtmp://217.217.253.247:1935/dr03
#
# Backend pull RTSP nội bộ MediaMTX (backend-ai/.env trên VPS):
#   VMS_CAMERA_SOURCES=...,DR-03:rtsp://127.0.0.1:8554/dr03
# CMS xem HLS relay:
# HC-01 — MediaMTX LL-HLS; WHEP ưu tiên trong app (~300ms)
VITE_HC01_STREAM_URL=https://217.217.253.247.nip.io/mediamtx/hls/hc-01/index.m3u8
# DR-03 — flycam MediaMTX LL-HLS
VITE_DR03_STREAM_URL=https://217.217.253.247.nip.io/mediamtx/hls/dr03/index.m3u8
#
# Path MediaMTX dự phòng (nếu drone publish thẳng vào MediaMTX thay vì RTMP ngoài):
# VITE_DR03_PATH=dr03
# VITE_DR03_RTSP_URL=rtsp://157.66.100.182:8554/dr-03

# Camera có VMS worker server-side ngoài danh sách mặc định (A-03, A-04, HC-01):
# VITE_VMS_CAMERA_IDS=A-05,B-02,DR-03
