# Copy file này thành .env rồi chỉnh theo máy/camera thực tế.
# Tất cả biến bên dưới đều có giá trị mặc định hợp lý trong app/config.py —
# chỉ cần tạo .env khi cần override.

# Nguồn camera: số index webcam (0, 1, 2...) hoặc URL RTSP/http.
# Trên macOS có nhiều camera ảo (vd Continuity Camera của iPhone) — nếu server
# kết nối nhầm camera, thử đổi giá trị này (0, 1, 2...).
CAMERA_SOURCE=0

HOST=0.0.0.0
PORT=8000

# Số khung hình/giây chạy detection (không cần bằng FPS thật của camera).
DETECTION_FPS=5.0
# Số khung hình/giây gửi qua WebSocket cho trang xem trực tiếp (static/index.html).
STREAM_FPS=12.0

# Model YOLO phát hiện lửa/khói (Hugging Face repo).
FIRE_MODEL_REPO=SalahALHaismawi/yolov26-fire-detection
FIRE_MODEL_FILE=best.pt
FIRE_CONF_THRESHOLD=0.62
# Detector heuristic (màu sắc + độ sáng + nhấp nháy) bắt lửa nhỏ/cận cảnh mà
# YOLO bỏ sót (bật lửa, diêm, lửa xanh dương của bật lửa khò).
FLAME_HEURISTIC_CONF_THRESHOLD=0.48

# Model YOLO phát hiện hút thuốc (điếu thuốc lá — tạm dùng chung cho vape).
SMOKING_MODEL_REPO=Enos-123/smoking-detection
SMOKING_MODEL_FILE=best.pt
SMOKING_CONF_THRESHOLD=0.5

# Thời gian tối thiểu giữa 2 sự kiện cùng loại (giây), tránh spam sự kiện.
EVENT_COOLDOWN_SECONDS=900.0

# Hút thuốc: bắt sau ~2.5s liên tục; lặp snapshot mỗi 15 phút nếu vẫn phát hiện.
SMOKING_EVENT_MIN_DURATION_SECONDS=2.5
SMOKING_EVENT_MAX_GAP_SECONDS=12.0
SMOKING_EVENT_COOLDOWN_SECONDS=900.0
SMOKING_EVENT_REPEAT_MIN_SECONDS=900.0

# Cháy nổ: bắt sau ~6s; nhắc lại sau 15 phút nếu vẫn phát hiện.
FIRE_EVENT_MIN_DURATION_SECONDS=6.0
FIRE_EVENT_MAX_GAP_SECONDS=3.0
FIRE_EVENT_COOLDOWN_SECONDS=900.0

# Cam A-03 / A-04 — lặp snapshot sự kiện mỗi 15 phút nếu vẫn phát hiện.
ROAD_EVENT_REPEAT_SECONDS=900.0
CRANE_EVENT_REPEAT_SECONDS=900.0
PPE_EVENT_REPEAT_SECONDS=900.0
PCCC_EVENT_REPEAT_SECONDS=900.0
WAH_EVENT_REPEAT_SECONDS=900.0
ATGT_EVENT_REPEAT_SECONDS=900.0

# --- Ghi sự kiện đầy đủ (vòng loop video đầu) ---
# Bật cả hai để A-03 ghi BPTC + ATGT-002/004. Tắt chỉ khi muốn overlay không log.
A03_BPTC_EVENT_LOGGING_ENABLED=true
ATGT_LANE_VIOLATION_ONLY=false

# Cửa sổ dedup: trong 3h cùng camera+scenario+vị trí → refresh snapshot, không tạo event mới.
# Sau 3h detect lại → event mới. Đây là mode production/audit — KHÔNG bật EVENT_TEST_MODE.
EVENT_FIRST_SEEN_WINDOW_SECONDS=10800
EVENT_TEST_MODE=false

# Số vòng loop video trước khi bật dedup 3h (2 = ghi đủ loop 1–2, từ loop 3 dedup).
EVENT_AUDIT_GRACE_LOOPS=2

# Checklist vòng loop đầu (2 cam):
#   1. DELETE /events (hoặc restart BE sau khi xóa) — reset dedup + JSONL
#   2. VMS_MODE_ENABLED=true + VMS_CAMERA_SOURCES=A-03:...,A-04:...
#   3. Chờ 1 vòng loop đủ dài (A-04 reel có segment PPE/PCCC/WAH/crane)
#   4. Loop lại trong 3h → chỉ cập nhật snapshot; sau 3h mới ghi thêm

# --- VMS mode (Phase 1) — server-side AI + HLS stream + clip ---
# Bật VMS: BE tự đọc MP4 lặp, chạy AI, xuất HLS, cắt clip khi confirm.
# FE xem HLS stream thay vì gửi frame qua /analyze.
VMS_MODE_ENABLED=false
# Format: "CameraID:/absolute/path/cam.mp4,CameraID2:..."
# Ví dụ VPS: HC-01 RTSP + fallback MP4 khi mũ chưa publish (path sau dấu |)
# VMS_CAMERA_SOURCES=A-03:/opt/vifence/videos/cam03.mp4,A-04:/path/cam04.mp4,HC-01:rtsp://157.66.100.182:8554/866926048126915|/opt/vifence/videos/bodycam-01.mp4
VMS_CAMERA_SOURCES=
# FPS AI trên server (VMS mode) — 6 FPS đủ ATLĐ, tiết kiệm CPU.
VMS_AI_FPS=6.0

# --- Auto-train (Contabo VPS: bật AUTO_TRAIN_ENABLED=true) ---
# Thu thập pseudo-label từ VMS + train YOLO — mặc định 2 lần/ngày (0h & 6h VN).
AUTO_TRAIN_ENABLED=false
AUTO_TRAIN_INFERENCE_ENABLED=true
AUTO_TRAIN_SCHEDULE_HOURS_LOCAL=0,6
AUTO_TRAIN_SCHEDULE_TZ_OFFSET_HOURS=7
AUTO_TRAIN_SCHEDULE_WINDOW_MINUTES=90
AUTO_TRAIN_CHECK_INTERVAL_SECONDS=120
AUTO_TRAIN_MIN_INTERVAL_SECONDS=39600
AUTO_TRAIN_MIN_NEW_SAMPLES_DELTA=10
