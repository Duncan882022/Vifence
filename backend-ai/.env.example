# Copy file này thành .env rồi chỉnh theo máy/camera thực tế.
# Tất cả biến bên dưới đều có giá trị mặc định hợp lý trong app/config.py —
# chỉ cần tạo .env khi cần override.

# Nguồn camera: số index webcam (0, 1, 2...) hoặc URL RTSP/http.
# Trên macOS có nhiều camera ảo (vd Continuity Camera của iPhone) — nếu server
# kết nối nhầm camera, thử đổi giá trị này (0, 1, 2...).
CAMERA_SOURCE=0

HOST=0.0.0.0
PORT=8000

# Số khung hình/giây chạy detection (không cần bằng FPS thật của camera).
DETECTION_FPS=5.0
# Số khung hình/giây gửi qua WebSocket cho trang xem trực tiếp (static/index.html).
STREAM_FPS=12.0

# Model YOLO phát hiện lửa/khói (Hugging Face repo).
FIRE_MODEL_REPO=SalahALHaismawi/yolov26-fire-detection
FIRE_MODEL_FILE=best.pt
FIRE_CONF_THRESHOLD=0.5
# Detector heuristic (màu sắc + độ sáng + nhấp nháy) bắt lửa nhỏ/cận cảnh mà
# YOLO bỏ sót (bật lửa, diêm, lửa xanh dương của bật lửa khò).
FLAME_HEURISTIC_CONF_THRESHOLD=0.35

# Model YOLO phát hiện hút thuốc (điếu thuốc lá — tạm dùng chung cho vape).
SMOKING_MODEL_REPO=Enos-123/smoking-detection
SMOKING_MODEL_FILE=best.pt
SMOKING_CONF_THRESHOLD=0.5

# Debounce: cần đủ DEBOUNCE_HITS lần phát hiện trong DEBOUNCE_WINDOW khung hình
# liên tiếp mới xác nhận là 1 sự kiện (chống báo nhầm do nhiễu 1 khung hình).
DEBOUNCE_HITS=3
DEBOUNCE_WINDOW=5
# Thời gian tối thiểu giữa 2 sự kiện cùng loại (giây), tránh spam sự kiện.
EVENT_COOLDOWN_SECONDS=30.0

# Hút thuốc: bắt sau ~2.5s liên tục; 1 sự kiện/phiên (log lại khi mất detect > 12s).
SMOKING_EVENT_MIN_DURATION_SECONDS=2.5
SMOKING_EVENT_MAX_GAP_SECONDS=12.0

# Cháy nổ: bắt sau ~6s; có thể nhắc lại sau 60s nếu vẫn phát hiện.
FIRE_EVENT_MIN_DURATION_SECONDS=6.0
FIRE_EVENT_MAX_GAP_SECONDS=3.0
FIRE_EVENT_COOLDOWN_SECONDS=60.0

# Không log lại cùng behavior trên cùng camera trong N giây.
EVENT_REPEAT_MIN_SECONDS=180.0
