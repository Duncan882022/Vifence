  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --host 127.0.0.1 --port 5173",
    "dev:local": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode ghpages && bash scripts/write-ghpages-404.sh",
    "preview:pages": "vite preview --outDir docs --base /Vifence/",
