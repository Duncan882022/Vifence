    "start:local": "bash scripts/start-local.sh",
    "start:fe": "bash scripts/start-fe-remote.sh",
    "start:backend": "bash scripts/start-backend-ngrok.sh",
    "pack:pages": "npm run build:pages && cd docs && zip -r ../vifence-pages.zip . && echo '→ Upload nội dung vifence-pages.zip lên root repo GitHub (duncan882022/Vifence)'",
